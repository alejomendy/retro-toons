# Copiá este archivo a .env.local y completá los valores.
# Todas son opcionales: sin ninguna, el sitio funciona con TVmaze y Wikipedia.

# ── TMDB: títulos/sinopsis en español latino, pósters, fondos, openings y dónde ver ──
# Cómo obtenerla: https://www.themoviedb.org/signup → Ajustes → API → solicitar clave (gratis).
# Alcanza con una de las dos.
TMDB_API_KEY=
TMDB_READ_TOKEN=
# País para "Dónde verla legalmente" (código ISO: AR, MX, CL, CO, PE...).
TMDB_REGION=AR

# ── YouTube Data API v3: buscar videos en español ──
# Cómo obtenerla: https://console.cloud.google.com → crear proyecto →
# "APIs y servicios" → habilitar "YouTube Data API v3" → Credenciales → Clave de API.
YOUTUBE_API_KEY=
# Región para priorizar resultados (MX, AR, ...).
YOUTUBE_REGION=MX
# Opcional: IDs de canales de YouTube (separados por coma). Si se define,
# solo se aceptan videos subidos por esos canales. Canales oficiales:
#   UC5M_h2S8Ldoc9M6f7B-_m6A  Nickelodeon
#   UC74bcC7aGRNz4KoRpJsJNEw  Nicktoons
#   UCGydrkfIhUDNCotYQI8TJhA  Cartoon Network UK
#   UCmst562fALOY2cKb4IFgqEg  Boomerang UK
#   UCVidE_ftg2nZUQyooJLchDQ  Boomerang
#   UCktaw9L-f65LzUUdjmCFkbQ  Disney Channel
# Ojo: los canales oficiales suben sobre todo clips, así que vas a encontrar
# menos episodios completos que buscando en todo YouTube.
YOUTUBE_CHANNEL_IDS=

# ── Dailymotion: buscar videos en español (no necesita clave) ──
DAILYMOTION_ENABLED=false
# Opcional: IDs de usuarios de Dailymotion permitidos (separados por coma).
DAILYMOTION_OWNERS=
# Player ID para embeber: https://www.dailymotion.com/partner → Players → crear (gratis).
# Sin esto el reproductor genérico de Dailymotion puede responder "Forbidden".
NEXT_PUBLIC_DAILYMOTION_PLAYER_ID=

# ── Wikipedia / Wikimedia (sin clave) ──
# Opcional pero recomendado: un email o URL de contacto para el User-Agent.
# Wikimedia limita menos los pedidos de clientes identificados.
WIKIMEDIA_CONTACT=

# ── Addon de LACartoons (Stremio): catálogo y videos. Solo se usa en el servidor. ──
# Local: corré el addon en 127.0.0.1:7000 (valor por defecto) o usá el de producción.
LACARTOONS_ADDON_URL=https://retrotoons-tv-addon.onrender.com
